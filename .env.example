# Copia este archivo a .env y completa los valores

# Puerto donde correra la web
PORT=3000

# Ruta del archivo SQLite. Dejala vacia para desarrollo local (usa ./data.sqlite).
# En Fly.io se setea sola a /data/data.sqlite (ver fly.toml) para que persista en el volumen.
# DB_PATH=/data/data.sqlite

# Webhook de Discord donde se publican las postulaciones
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# Webhook de Discord donde se avisa cuando se marca una nómina como pagada
DISCORD_PAYROLL_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# Secreto para firmar la cookie de sesion del panel admin (poné cualquier texto largo random)
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Credenciales del admin (la contraseña se guarda como hash, ver scripts/seed-admin.js).
# En Vercel además se usan para re-sembrar el usuario admin en cada cold start (ver db.js).
ADMIN_USER=admin
# ADMIN_PASSWORD=otra-contraseña-segura
# ADMIN_DEPARTMENT=sams  (opcional: "sams" o "safd". Sin esto, ve todos los departamentos)
